  },
  "supersedes": "2026-11-07 layout: one SUKHOI and big SU-30 was not the reference slot mapping.",
  "inpainting": {
    "small_slots": "Restore archived reference substrate, erase tight old-ink bounds with local closing/inpainting (opening for white engine ink), paste glyph alpha only. Joint C and R/B treatment. Never fill slot rectangles.",
    "large_fin": "Recover macro light/dark field from hatch gaps inside the probed island; keep only largest dark connected component as upper band. Sample both classes outside old word polygon, sigma22 normalized convolution with median fallback, clamp p10-3 to p90+3.",
    "type": "Angular slashed-zero number glyphs, condensed sheared manufacturer glyphs, preserve aspect ratio; hatch after final rotation/resize.",
    "preserve": [
      "native G/A",
      "C alpha",
      "ENDFIELD",
      "01",
      "world art",
      "generic technical markings"
    ]
  },
  "material_policy": "All paint and inscriptions retain raw reference R/B 102/178; glyphs alter C only. See 2026-11-09 correction."
